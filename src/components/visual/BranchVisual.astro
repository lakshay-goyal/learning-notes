---
/**
 * BranchVisual — a reusable, dependency-free branch diagram (git or any
 * two-track flow). Renders as inline SVG, so it is visible in dev and build,
 * in light and dark mode, with no JavaScript and no reading required.
 */
interface Props {
  mode?: 'merge' | 'fast-forward';
  mainName?: string;
  branchName?: string;
  /** Commit labels along the main lane, oldest first. Last one is the merge. */
  main: string[];
  /** Commit labels along the side lane, oldest first. */
  branch?: string[];
}
const {
  mode = 'merge',
  mainName = 'master',
  branchName = 'bugfix',
  main,
  branch = [],
} = Astro.props;

const dx = 120;
const pad = 78;
const mainY = 104;
const branchY = 34;
const lastX = pad + Math.max(main.length - 1, branch.length, 1) * dx;
const width = lastX + pad;
const height = mode === 'merge' ? 148 : 150;
const mainX = (i: number) => pad + i * dx;
const branchX = (j: number) => pad + (j + 1) * dx;
const mergeX = mainX(main.length - 1);
---

<figure class="bviz not-content">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    width="100%"
    role="img"
    aria-label={`${branchName} branching off ${mainName}`}
  >
    <defs>
      <marker id="bviz-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 1 L 9 5 L 0 9 z" class="arrow-head"></path>
      </marker>
    </defs>

    {
      mode === 'merge' ? (
        <>
          {/* lane tag: main */}
          <g class="lane-tag" transform="translate(6, 92)">
            <rect width="58" height="22" rx="11"></rect>
            <text x="29" y="15">{mainName}</text>
          </g>
          {/* lane tag: branch */}
          <g class="lane-tag side" transform="translate(6, 22)">
            <rect width="58" height="22" rx="11"></rect>
            <text x="29" y="15">{branchName}</text>
          </g>
          {/* main lane */}
          <line x1={pad - 34} y1={mainY} x2={mergeX} y2={mainY} class="lane" />
          {/* branch-off curve */}
          <path
            d={`M ${mainX(0)} ${mainY} C ${mainX(0) + 30} ${mainY}, ${branchX(0) - 40} ${branchY}, ${branchX(0) - 10} ${branchY}`}
            class="lane side"
            marker-end="url(#bviz-arrow)"
          />
          {/* branch lane */}
          <line x1={branchX(0)} y1={branchY} x2={branchX(branch.length - 1)} y2={branchY} class="lane side" />
          {/* merge curve back into main */}
          <path
            d={`M ${branchX(branch.length - 1)} ${branchY} C ${branchX(branch.length - 1) + 34} ${branchY}, ${mergeX - 44} ${mainY}, ${mergeX - 12} ${mainY}`}
            class="lane side"
            marker-end="url(#bviz-arrow)"
          />
          {/* main commits */}
          {main.map((c, i) => (
            <g class={`commit ${i === main.length - 1 ? 'merge' : ''}`}>
              <circle cx={mainX(i)} cy={mainY} r="9"></circle>
              <text x={mainX(i)} y={mainY + 30}>{c}</text>
            </g>
          ))}
          {/* branch commits */}
          {branch.map((c, j) => (
            <g class="commit side">
              <circle cx={branchX(j)} cy={branchY} r="9"></circle>
              <text x={branchX(j)} y={branchY - 16}>{c}</text>
            </g>
          ))}
        </>
      ) : (
        <>
          {/* single straight lane: nothing to reconcile */}
          <line x1={pad - 34} y1="70" x2={lastX} y2="70" class="lane" />
          {main.map((c, i) => (
            <g class="commit">
              <circle cx={mainX(i)} cy="70" r="9"></circle>
              <text x={mainX(i)} y="102">{c}</text>
            </g>
          ))}
          <text x={mainX(0)} y="132" class="note">⬆ {mainName} was here</text>
          <text x={mergeX} y="132" class="note accent" text-anchor="end">
            {mainName} + {branchName} now ⬆
          </text>
          <line x1={mainX(0)} y1="58" x2={mergeX} y2="58" class="catchup" marker-end="url(#bviz-arrow)" />
        </>
      )
    }
  </svg>
</figure>

<style>
  .bviz {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    padding: 0.75rem 0.5rem 0.25rem;
    margin: 1rem 0;
    overflow-x: auto;
  }
  .bviz svg {
    min-width: 420px;
    display: block;
  }
  .bviz .lane {
    stroke: var(--sl-color-gray-4);
    stroke-width: 2.5;
    fill: none;
  }
  .bviz .lane.side {
    stroke: #22c55e;
  }
  .bviz .arrow-head {
    fill: var(--sl-color-gray-3);
  }
  .bviz .commit circle {
    fill: var(--sl-color-accent);
    stroke: #fff;
    stroke-width: 2;
  }
  .bviz .commit.side circle {
    fill: #22c55e;
  }
  .bviz .commit.merge circle {
    r: 12;
    fill: var(--sl-color-accent);
  }
  .bviz .commit text {
    fill: var(--sl-color-gray-2);
    font-size: 12px;
    text-anchor: middle;
  }
  .bviz .lane-tag rect {
    fill: var(--sl-color-accent);
    fill-opacity: 0.16;
  }
  .bviz .lane-tag text {
    fill: var(--sl-color-accent);
    font-size: 11px;
    font-weight: 700;
    text-anchor: middle;
  }
  .bviz .lane-tag.side rect {
    fill: #22c55e;
    fill-opacity: 0.16;
  }
  .bviz .lane-tag.side text {
    fill: #22c55e;
  }
  .bviz .note {
    fill: var(--sl-color-gray-3);
    font-size: 12px;
    text-anchor: middle;
  }
  .bviz .note.accent {
    fill: var(--sl-color-accent);
    font-weight: 700;
  }
  .bviz .catchup {
    stroke: var(--sl-color-accent);
    stroke-width: 2;
    stroke-dasharray: 6 5;
    fill: none;
  }
  .bviz .commit {
    transition: transform 0.15s;
  }
  .bviz .commit:hover {
    transform: scale(1.15);
  }
</style>
