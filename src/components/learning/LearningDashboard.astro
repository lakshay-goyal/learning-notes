---
import { getCollection } from 'astro:content';

/**
 * Topics, not pages.
 *
 * The dashboard used to build one card per learning page keyed by `learning.id`.
 * Under the multi-page contract that produces a duplicate card per child page:
 * the same topic appearing five times, each "open latest topic" link pointing at
 * whichever page happened to sort first. Cards are now grouped by `topicId` and
 * link to the topic's overview, and a topic shows its page count.
 */
const pages = (await getCollection('docs')).filter((entry) => entry.data.learning);

const topics = [];
for (const entry of pages) {
	const learning = entry.data.learning!;
	const topicId = learning.topicId ?? learning.id;
	const href = `/${entry.id.replace(/\/index$/, '')}/`;
	const existing = topics.find((topic) => topic.id === topicId);
	if (existing) {
		existing.pages += 1;
		if (learning.kind === 'overview') {
			// The overview is the canonical route for the topic.
			existing.href = href;
			existing.title = entry.data.title;
			existing.description = entry.data.description ?? '';
		}
		continue;
	}
	topics.push({
		id: topicId,
		title: entry.data.title,
		description: entry.data.description ?? '',
		category: learning.category,
		difficulty: learning.difficulty,
		updated: learning.updated.toISOString(),
		href,
		pages: 1,
	});
}

topics.sort((a, b) => b.updated.localeCompare(a.updated));
---

<section class="learning-dashboard not-content" data-learning-dashboard data-topics={JSON.stringify(topics)} aria-labelledby="learning-dashboard-title">
	<header>
		<div>
			<p class="learning-kicker">Personal knowledge</p>
			<h2 id="learning-dashboard-title">Learning dashboard</h2>
			<p>Browse published knowledge, resume study, and see reviews saved in this browser.</p>
		</div>
		<a class="learning-action" href={topics[0]?.href ?? '#topics'}>Open latest topic</a>
	</header>

	<div class="dashboard-grid">
		<article>
			<span class="metric" data-topic-count>{topics.length}</span>
			<strong>Topics</strong>
			<small>{pages.length} page{pages.length === 1 ? '' : 's'} of source-backed lessons</small>
		</article>
		<article>
			<span class="metric" data-due-count>0</span>
			<strong>Reviews due</strong>
			<small data-due-detail>No browser progress yet</small>
		</article>
		<article>
			<span class="metric" data-studying-count>0</span>
			<strong>Currently studying</strong>
			<small data-studying-detail>Open a topic to begin</small>
		</article>
	</div>

	<div class="dashboard-sections">
		<div>
			<h3>My knowledge</h3>
			<div class="topic-list">
				{topics.map((topic) => (
					<a href={topic.href} data-topic-card={topic.id}>
						<span class="topic-topline">
							<small>{topic.category}</small>
							<em>{topic.pages > 1 ? `${topic.pages} pages · ${topic.difficulty}` : topic.difficulty}</em>
						</span>
						<strong>{topic.title}</strong>
						<span>{topic.description}</span>
					</a>
				))}
				{topics.length === 0 && <p class="empty">No visual learning topics have been published yet.</p>}
			</div>
		</div>
		<div class="review-queue">
			<h3>Today’s reviews</h3>
			<div data-review-list>
				<p class="empty">No reviews are due in this browser. Rate a recall question to start a schedule.</p>
			</div>
			<p class="empty">Progress is stored in this browser only and is not synchronized across devices.</p>
		</div>
	</div>
</section>

<script>
	import { dueTopicIds, readProgress, storageAvailable } from './progress-store.mjs';

	function renderDashboard() {
		document.querySelectorAll('[data-learning-dashboard]').forEach((root) => {
			if (!(root instanceof HTMLElement)) return;
			const topics = JSON.parse(root.dataset.topics || '[]');
			const saved = readProgress().topics ?? {};
			const due = dueTopicIds();
			const studying = Object.values(saved).filter((topic) => topic.status === 'studying');
			const usable = storageAvailable();

			const setText = (selector, value) => {
				const element = root.querySelector(selector);
				if (element) element.textContent = String(value);
			};
			setText('[data-due-count]', usable ? due.size : 'n/a');
			setText('[data-studying-count]', usable ? studying.length : 'n/a');
			setText(
				'[data-due-detail]',
				!usable
					? 'Progress storage unavailable in this browser'
					: due.size
						? 'Ready for active recall'
						: 'Nothing scheduled today',
			);
			setText(
				'[data-studying-detail]',
				usable && studying.length ? 'Resume from your last opened topic' : 'Open a topic to begin',
			);

			const reviewList = root.querySelector('[data-review-list]');
			if (reviewList) {
				reviewList.innerHTML = '';
				if (!usable) {
					const note = document.createElement('p');
					note.className = 'empty';
					note.textContent = 'Progress cannot be saved in this browser. The lesson content is unaffected.';
					reviewList.append(note);
				} else if (due.size) {
					for (const id of due) {
						const topic = topics.find((item) => item.id === id);
						if (!topic) continue;
						const link = document.createElement('a');
						link.href = `${topic.href}#test-yourself`;
						link.textContent = `${topic.title} →`;
						reviewList.append(link);
					}
				} else {
					const empty = document.createElement('p');
					empty.className = 'empty';
					empty.textContent = 'No reviews are due. Rate a recall question to start a schedule.';
					reviewList.append(empty);
				}
			}

			for (const [id, topic] of Object.entries(saved)) {
				const card = root.querySelector(`[data-topic-card="${CSS.escape(id)}"]`);
				if (!(card instanceof HTMLElement)) continue;
				card.dataset.progress = topic.status ?? 'studying';
				// Recorded answers, not a mastery claim. This is the only signal
				// that turns the accent green.
				card.dataset.answers = String(Object.keys(topic.questions ?? {}).length);
			}
		});
	}

	document.addEventListener('astro:page-load', renderDashboard);
	window.addEventListener('deep-learn-progress', renderDashboard);
	renderDashboard();
</script>

<style>
	.learning-dashboard { margin: 1.5rem 0 2.25rem; border: 1px solid var(--learn-border); border-radius: 1.1rem; padding: clamp(1rem, 3vw, 1.5rem); background: linear-gradient(145deg, color-mix(in srgb, var(--learn-blue) 7%, var(--sl-color-bg)), var(--sl-color-bg) 52%, color-mix(in srgb, var(--learn-purple) 6%, var(--sl-color-bg))); box-shadow: var(--learn-shadow); }
	header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
	header h2 { margin: 0; font-size: clamp(1.35rem, 3vw, 1.85rem); }
	header p:last-child { margin: 0.35rem 0 0; color: var(--sl-color-gray-2); font-size: 0.9rem; }
	header .learning-action { text-decoration: none; white-space: nowrap; }
	.dashboard-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.7rem; margin-top: 1.1rem; }
	.dashboard-grid article { display: grid; gap: 0.08rem; border: 1px solid var(--learn-border); border-radius: 0.85rem; padding: 0.9rem; background: color-mix(in srgb, var(--sl-color-bg) 90%, transparent); }
	.metric { color: var(--sl-color-accent-high); font-size: 1.7rem; font-weight: 850; letter-spacing: -0.04em; }
	.dashboard-grid strong { font-size: 0.85rem; }
	.dashboard-grid small { color: var(--sl-color-gray-3); font-size: 0.7rem; }
	.dashboard-sections { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(13rem, 0.8fr); gap: 1rem; margin-top: 1.15rem; }
	.dashboard-sections h3 { margin: 0 0 0.55rem; font-size: 0.88rem; letter-spacing: 0.04em; text-transform: uppercase; }
	.topic-list { display: grid; gap: 0.55rem; }
	.topic-list > a { display: grid; gap: 0.3rem; border: 1px solid var(--learn-border); border-radius: 0.8rem; padding: 0.8rem; background: var(--sl-color-bg); color: inherit; text-decoration: none; }
	.topic-list > a:hover { border-color: var(--sl-color-accent); transform: translateY(-1px); }
	/* Two honest states only: opened, or has recorded answers. There is no
	   "learned" state, because a self-rating is not evidence of competence. */
	.topic-list > a[data-progress='studying'] { border-left: 4px solid var(--learn-blue); }
	.topic-list > a[data-answers]:not([data-answers='0']) { border-left: 4px solid var(--learn-green); }
	.topic-topline { display: flex; justify-content: space-between; gap: 0.5rem; }
	.topic-topline small { color: var(--learn-blue); font-size: 0.68rem; font-weight: 800; text-transform: uppercase; }
	.topic-topline em { color: var(--sl-color-gray-3); font-size: 0.68rem; font-style: normal; }
	.topic-list > a > span:last-child { color: var(--sl-color-gray-2); font-size: 0.78rem; line-height: 1.4; }
	.review-queue { border-left: 1px solid var(--learn-border); padding-left: 1rem; }
	.review-queue [data-review-list] { display: grid; gap: 0.45rem; }
	.review-queue a { border-radius: 0.65rem; padding: 0.6rem; background: color-mix(in srgb, var(--learn-amber) 10%, var(--sl-color-bg)); font-size: 0.8rem; font-weight: 700; text-decoration: none; }
	.empty { margin: 0; color: var(--sl-color-gray-3); font-size: 0.78rem; line-height: 1.5; }
	.review-queue .empty + .empty { margin-top: 0.6rem; font-size: 0.7rem; }
	@media (max-width: 46rem) {
		header { align-items: start; flex-direction: column; }
		.dashboard-grid,
		.dashboard-sections { grid-template-columns: 1fr; }
		.review-queue { border-top: 1px solid var(--learn-border); border-left: 0; padding-top: 1rem; padding-left: 0; }
	}
</style>