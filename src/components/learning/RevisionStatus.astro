---
interface Props {
	topicId: string;
	title: string;
}

const { topicId, title } = Astro.props;
---

<aside class="revision-status not-content" data-revision-status data-topic-id={topicId} data-title={title}>
	<div>
		<p class="learning-kicker">Retention</p>
		<strong data-revision-label>Not yet reviewed</strong>
		<span data-revision-detail>Progress stays in this browser only.</span>
	</div>
	<div class="revision-actions">
		<a href="#test-yourself">Review questions</a>
	</div>
</aside>

<script>
	import { readTopic, storageAvailable, writeTopic } from './progress-store.mjs';

	/**
	 * This component reports evidence, never mastery.
	 *
	 * It used to ship a "Mark learned" button that set `status: learned`. A
	 * self-rating is not evidence of competence: a learner can click it without
	 * answering anything. The harness is explicit that mastery is not claimed
	 * from a button, so the button is gone and the panel reports only what
	 * actually happened — recall attempts and their ratings.
	 */
	function wireRevisionStatus() {
		document.querySelectorAll('[data-revision-status]').forEach((root) => {
			if (!(root instanceof HTMLElement) || root.dataset.wired === 'true') return;
			root.dataset.wired = 'true';
			const topicId = root.dataset.topicId;
			const title = root.dataset.title;
			const label = root.querySelector('[data-revision-label]');
			const detail = root.querySelector('[data-revision-detail]');
			if (!topicId) return;

			const usable = storageAvailable();
			const render = () => {
				const topic = readTopic(topicId);
				const attempted = Object.values(topic.questions ?? {});
				const ratings = attempted.filter((entry) => entry.rating).length;

				if (label) {
					if (!usable) {
						label.textContent = 'Progress unavailable';
					} else if (!attempted.length) {
						label.textContent = 'Not yet reviewed';
					} else {
						// Report what was done, not a level of mastery.
						label.textContent = `${ratings} of ${attempted.length} recall prompt${attempted.length === 1 ? '' : 's'} answered`;
					}
				}
				if (detail) {
					detail.textContent = !usable
						? 'This browser cannot store progress. The lesson content is unaffected.'
						: attempted.length
							? 'Answers are recorded, not a mastery claim · browser-local, not synchronized'
							: 'Answer a recall prompt to record evidence · browser-local, not synchronized';
				}
			};

			if (usable && title) {
				// Opening a topic records that it was opened. That is exposure, and
				// it is labelled as such rather than as progress.
				writeTopic(topicId, { title, status: 'studying', lastOpened: new Date().toISOString() });
			}
			render();

			window.addEventListener('deep-learn-progress', render);
			document.addEventListener('astro:page-load', render);
		});
	}

	wireRevisionStatus();
	document.addEventListener('astro:page-load', wireRevisionStatus);
</script>

<style>
	.revision-status {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin: 1rem 0 1.5rem;
		border: 1px solid var(--learn-border);
		border-radius: 0.9rem;
		padding: 0.85rem 1rem;
		background: color-mix(in srgb, var(--learn-green) 7%, var(--sl-color-bg));
	}
	.revision-status > div:first-child { display: grid; gap: 0.12rem; }
	.revision-status strong { font-size: 0.92rem; }
	.revision-status span { color: var(--sl-color-gray-3); font-size: 0.75rem; }
	.revision-actions { display: flex; align-items: center; gap: 0.65rem; }
	.revision-actions a { font-size: 0.8rem; font-weight: 700; white-space: nowrap; }
	@media (max-width: 38rem) {
		.revision-status { align-items: stretch; flex-direction: column; }
		.revision-actions { justify-content: space-between; }
	}
</style>